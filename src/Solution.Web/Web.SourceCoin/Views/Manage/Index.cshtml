<script type="text/javascript">
    Number.prototype.amountformat = function (n, x) {
        var re = '\\d(?=(\\d{' + (x || 3) + '})+' + (n > 0 ? '\\.' : '$') + ')';
        return this.toFixed(Math.max(0, ~~n)).replace(new RegExp(re, 'g'), '$&,');
    };

    $("#find-username").keypress(function (event) {
        if (event.which == 13) {
            $('#btn-find-user').click();
        }
    });

    $(document).ready(function () {
        $('#btn-find-user').on('click', function () {
            var username = $("#find-username").val();
            if (username.length > 0) {
                $.ajax({
                    url: '/manage/usersearch',
                    type: 'POST',
                    data: JSON.stringify({ username: username }),
                    dataType: 'json',
                    contentType: 'application/json; charset=utf-8',
                    beforeSend: function () {
                        CommonHelper.AjaxLoading();
                    },
                    success: function (result) {
                        CommonHelper.StopAjaxLoading();
                        var dasboarch = result.Dasboarch;                        
                        $("#usd-wallet").text("$" + dasboarch.MoneyUSD.amountformat(2));
                        $("#stock-wallet").text("P " + dasboarch.BonusLucky.amountformat(2));
                        $("#total-networks").text(dasboarch.TotalNetwork);
                        $("#total-invest").text("$" + dasboarch.TotalInvestment.amountformat(2));
                        $("#bonus-commission").text("$" + dasboarch.BonusCommission.amountformat(2));
                        $("#bonus-branch").text("$" + dasboarch.BonusBranch.amountformat(2));
                        $("#total-stock").text("P " + dasboarch.TotalReceived.amountformat(2));
                        $("#total-left-right").text("$" + dasboarch.TotalBranchLeft.amountformat(2) + " | $" + dasboarch.TotalBranchRight.amountformat(2));
                        $("#max-investment").text("$" + dasboarch.MaxInvest.amountformat(2));
                        $("#maxout-bonus").text(0);
                        $("#total-daily-profit").text("$" + dasboarch.TotalProfit.amountformat(2));

                        var target = result.Target;
                        $("#txt-message-progress").text("Complete " + target.Target.amountformat(2) + " on " + target.Node + " branches to gain " + target.Bonus.amountformat(2) + " bonuses");
                        $("div.progress").html('<div class="progress-bar" role="progressbar" aria-valuenow="' + target.Percent + '" aria-valuemin="0" aria-valuemax="100" style="width:' + target.Percent + '%">' + target.Percent +'%</div>');
                    },
                    error: function () {
                        CommonHelper.StopAjaxLoading();
                    }
                });

                lib_load_list.LoadList();
            }
        });
    });

    lib_load_list.GetCustomLoadListData = function () {
            var self = this;
            var data = {
                pageIndex: self.PageIndex,
                pageSize: self.PageSize,
                type: $("#id-bonus").val(),
                from_date: $("#from-date").val(),
                to_date: $("#to-date").val(),
                username: $("#find-username").val()
            };

            return data;
        }
    lib_load_list.DisplayCallBackSuccess = function (result) {
            var self = this;

        if ((result.Message == null || result.Message == "") && result.Result != null) {
                self.Total = result.Optional;
                data = new jqueryRenderTable();

                data.addColumn('number', 'No');
                data.addColumn('string', 'CreateOn');
                data.addColumn('string', 'By User');
                data.addColumn('string', 'Type');
                data.addColumn('string', 'Amount');
                data.addColumn('string', 'Description');

                if (result.Result.length > 0) {
                    for (var i = 0; i < result.Result.length; i++) {
                        var item = result.Result[i];
                        amount = "";
                        if (item.Amount < 0) {
                            amount = '<font color="red">' + item.Amount.amountformat(2) + '</font>';
                        } else {
                            amount = '<font color="forestgreen">' + item.Amount.amountformat(2) + '</font>';
                        }

                        var tmpRow = [
                            (i + 1),
                            "<i class='fa fa-calendar'></i>" + item.StrCreateOn,
                            "<i class='fa fa-user'></i>" + item.FromUser,
                            "<i class='fa fa-exchange'></i>" + item.TypeName,
                            "<i class='fa'></i>" + amount,
                            "<i class='fa fa-commenting'></i>" + item.Description
                        ];
                        data.addRow(tmpRow);
                    }
                    self.DrawTable(data);
                }
                else {
                    var tmpRow1 = ["There are no data to display."];
                    data.addRow(tmpRow1, 6);
                    self.DrawTable(data);
                }
            }
        }
    lib_load_list.Init("@Url.Action("TransactionList")", "15");
    CommonHelper.SetHeadingTitle("Manage Transaction");
</script>