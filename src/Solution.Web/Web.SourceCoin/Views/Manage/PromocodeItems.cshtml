@model Lib.Domain.Promocodes.Promocode_User_Mapping
@{
    ViewBag.Title = "PromocodeItems";
    Layout = "~/Views/Shared/_LayoutManage.cshtml";
}
<section style="clear:both;padding-top:20px;">
    <div id="admin-container">
        <div class="tool-bar">
            <a href="javascript:void(0);" onclick="lib_load_list.LoadDetailData(-1);" class="button green">Create</a>
        </div>
        @Html.Partial("_MultiAdminTable")
    </div>
</section>
<div id="dialog-model" title="Manage Promocode items" style="display:none">
    @using (Html.BeginForm())
    {
        @Html.EditorForModel()
    }
</div>
<script type='text/javascript'>
    lib_load_list.GetCustomLoadListData = function () {
            var self = this;
            var data = {
                pageIndex: self.PageIndex,
                orderClause: self.GetOrderClause(),
                proId: @Model.PromocodeId
            };

            return data;
        }
    lib_load_list.DisplayCallBackSuccess = function (result) {
            var self = this;

            if (result.Message == null || result.Message == "") {
                self.Total = result.Optional;

                data = new RenderTable();
                data.addColumn('number', 'Id');
                data.addColumn('string', 'Username');
                data.addColumn('string', 'Email');
                data.addColumn('string', 'Code');
                data.addColumn('string', 'Edit');

                if (result.Result.length > 0) {
                    for (var i = 0; i < result.Result.length; i++) {
                        var item = result.Result[i];
                        var btnRow = self.GetRowButton({
                            Id: item.Id,
                            Edit: true
                        });

                        var tmpRow = [
                            item.Id,
                            item.Username,
                            item.Email,
                            item.Code,
                            btnRow
                        ];
                        data.addRow(tmpRow);
                    }
                    self.DrawTable(data);
                    $(".table-list table").addClass("table");
                }
                else {
                    $("#" + self.ContainerId + " .table-list").html(CommonPhrase.NoData);
                    $(".table-list table").addClass("table");
                }
            }
            else {
                CommonHelper.ShowMsg("Error: " + result.Message, MsgIconType.Error);
            }
        }
    lib_load_list.LoadDetailUrl = "@Url.Action("GetDetailPromocodeItems", new {promocodeId=Model.PromocodeId })";
    lib_load_list.ManageUrl = "@Url.Action("ManagePromocodeItems")";
    lib_load_list.Init("@Url.Action("ListPromocodeItems")", "20");
        CommonHelper.SetHeadingTitle("Manage Promocode items");
</script>
