@model Lib.Domain.Trees.TreeDataList
@using Lib.Domain.Trees
@{
    ViewBag.Title = "ManageAccount";
    Layout = "~/Views/Shared/_LayoutManage.cshtml";
}
@*table export*@
<link rel='stylesheet' href='http://cdn.datatables.net/1.10.12/css/jquery.dataTables.css'>
<link rel='stylesheet' href='https://maxcdn.bootstrapcdn.com/bootstrap/3.3.5/css/bootstrap.min.css'>
@*<link href="~/Content/Export/css/style.css" rel="stylesheet" />*@
@*End table export*@
<link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">

<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
<script type="text/javascript">
    $(function () {
        $("#to-date").datepicker({ dateFormat: 'yy-mm-dd' });
        $("#from-date").datepicker({ dateFormat: 'yy-mm-dd' }).bind("change", function () {
            var minValue = $(this).val();
            minValue = $.datepicker.parseDate("yy-mm-dd", minValue);
            minValue.setDate(minValue.getDate());
            $("#to-date").datepicker("option", "minDate", minValue);
        })
    });
</script>
<style type="text/css">
    .transaction_select ul li {
        width: 24.33%;
    }

    #txtvalue, #btnfind {
        display: none;
    }
    .dataTables_wrapper .dataTables_filter {
        float: left !important;
        text-align: right;
    }
</style>
<section class="admin_body_bottom">
    <div class="row">
        <div class="col-2">
            <select autocomplete="off" id="select-invest" class="form-control input-common ng-untouched ng-pristine ng-valid" style="height: auto;">
                <option value="-1">-- Select Invest By --</option>
                <option value="3">USD</option>
                <option value="4">USDT</option>
                <option value="1">BTC</option>
            </select>
        </div>
        <div class="col-2">
            <select autocomplete="off" id="select-level" class="form-control input-common ng-untouched ng-pristine ng-valid" style="height: auto;">
                <option value="-1">-- Select Generation --</option>
                <option value="1">1st Generation</option>
                <option value="2">2nd Generation</option>
                <option value="3">3th Generation</option>
                <option value="4">4th Generation</option>
                <option value="5">5th Generation</option>
                <option value="6">6th Generation</option>
                <option value="7">7th Generation</option>
                <option value="8">8th Generation</option>
                <option value="9">9th Generation</option>
                <option value="10">10th Generation</option>
                <option value="11">11th Generation</option>
                <option value="12">12th Generation</option>
                <option value="13">13th Generation</option>
                <option value="14">14th Generation</option>
                <option value="15">15th Generation</option>
            </select>
        </div>
        <div class="col-2"><input type="text" id="from-date" placeholder="From date" class="form-control"></div>
        <div class="col-2"><input type="text" id="to-date" placeholder="To date" class="form-control"></div>
        <div class="col-2" style="display: inline-flex"><input type="text" id="find-username" value="@User.Identity.Name" placeholder="Username, Email" class="form-control" style="float: left"><font color="red" style="float: left">*</font></div>
        <div class="col-2"><a href="javascript:void(0);" class="btn btn-success" id="btn-search-tree" style="width:100%">Search</a></div>
    </div>
        <div class="row">
            <div class="col-md-12">
                <div style="width:100%;text-align:right;color:red;font-weight:bold;padding:15px;">Total Package: $<span id="total-tree"></span></div>
                <table id="dtListReferrals" class="table table-striped table-bordered dataTable no-footer" style="margin-top: 20px">
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Username</th>
                            <th>Full Name</th>
                            <th>Wallet</th>
                            <th>Package USD</th>
                            <th>Invest At</th>
                        </tr>
                    </thead>
                    <tbody id="html-data"></tbody>
                </table>
            </div>
        </div>
    </section>
<script type="text/javascript">
    function showData() {
        var data = {
            "level": $("#select-level").val(),
            "from_date": $("#from-date").val(),
            "to_date": $("#to-date").val(),
            "method": $("#select-invest").val(),
            "name": $("#find-username").val()
        };
        $.ajax({
            url: '/manage/manageaccount',
            type: 'POST',
            dataType: 'json',
            data: JSON.stringify(data),
            contentType: 'application/json; charset=utf-8',
            beforeSend: function () {
                CommonHelper.AjaxLoading();
            },
            success: function (result) {
                CommonHelper.StopAjaxLoading();
                if (result != null && result != "") {
                    $("#html-data").html(result.html);
                    $("#total-tree").text(result.total);
                } else {
                    $("#html-data").html("");
                    $("#total-tree").text(0);
                }
                //ExportData("dtListReferrals");
            },
            error: function () {
                CommonHelper.StopAjaxLoading();
            }
        });
    }

    showData();
    $(document).ready(function () {
        $('#btn-search-tree').click(function () {
            showData();
        });
    });
    function tranfer_xrp(id) {
        if (confirm("You sure ?")) {
            var data = {
                "id": id
            }
            $.ajax({
                url: '/manage/tranfer_xrp',
                type: 'POST',
                dataType: 'json',
                data: JSON.stringify(data),
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    CommonHelper.AjaxLoading();
                },
                success: function (result) {
                    CommonHelper.StopAjaxLoading();
                    if (result > 0) {
                        var name = "tranfer-" + id;
                        $("#" + name).text("Success");
                        $("#" + name).removeAttr("onclick");
                        $("#" + name).removeAttr("style");
                        $("#" + name).css("color", "green");
                    } else {
                        alert("Update fail.");
                    }
                },
                error: function () {
                    CommonHelper.StopAjaxLoading();
                }
            });
        }
    }
</script>
