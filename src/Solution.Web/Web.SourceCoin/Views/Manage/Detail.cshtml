<script>
    $(document).ready(function () {
        $("#btn-approve").click(function () {
            if (confirm("You sure want approve ?")) {
                $.ajax({
                    type: "POST",
                    url: '/manage/kycapprove',
                    data: { 'userId': @Model.UserId },
                    dataType: 'json',
                    beforeSend: function () {
                        CommonHelper.AjaxLoading();
                    },
                    success: function (response) {
                        CommonHelper.StopAjaxLoading();
                        if (response == 1) {
                            alert('Approve success')
                        }
                    },
                    error: function (error) {
                        CommonHelper.StopAjaxLoading();
                        alert("Unknown");
                    }
                });
            }
        });
        $("#btn-cancel").click(function () {
            if (confirm("You sure want remove ?")) {
                $.ajax({
                    type: "POST",
                    url: '/manage/kycremove',
                    data: { 'userId': @Model.UserId },
                    dataType: 'json',
                    beforeSend: function () {
                        CommonHelper.AjaxLoading();
                    },
                    success: function (response) {
                        CommonHelper.StopAjaxLoading();
                        if (response == 1) {
                            alert('Remove success')
                        }
                    },
                    error: function (error) {
                        CommonHelper.StopAjaxLoading();
                        alert("Unknown");
                    }
                });
            }
        });
        $('#PhoneNatural option[value=@Model.PhoneNatural]').attr('selected', 'selected');
        $('#Country option[value=@Model.Country]').attr('selected', 'selected');
        $('#IdentificationType option[value=@Model.IdentificationType]').attr('selected', 'selected');
    });
</script>
