
@{
    ViewBag.Title = "ApproveEth";
    Layout = "~/Views/Shared/_LayoutManage.cshtml";
}
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card mb-3">
                    <div class="card-header" id="title-transaction"></div>
                    <div class="card-body table-responsive p-0">
                        <div class="row" style="margin-bottom: 20px;">
                            <div class="col-lg-2">
                                <select autocomplete="off" id="id-status" class="form-control">
                                    <option value="0">Waiting</option>
                                    <option value="1" selected>Pending</option>
                                    <option value="2">Processing</option>
                                    <option value="3">Completed</option>
                                    <option value="4">Fail</option>
                                </select>
                            </div>
                            <div class="col-lg-2 col-md-2">
                                <a href="javascript:void(0);" onclick="lib_load_list.LoadList();" class="btn btn-warning">Search</a>
                            </div>
                        </div>
                        <div id="admin-container">
                            @Html.Partial("_MultiAdminTable")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script type='text/javascript'>
    lib_load_list.GetCustomLoadListData = function () {
        var self = this;
        var data = {
            pageIndex: self.PageIndex,
            orderClause: self.GetOrderClause(),
            status: $("#id-status").val()
        };
        return data;
    }
    lib_load_list.DisplayCallBackSuccess = function (result) {
        var self = this;

        if (result.Message == null || result.Message == "") {
            self.Total = result.Optional;

            data = new jqueryRenderTable();
            data.addColumn('number', 'Id');
            data.addColumn('string', 'Username');
            data.addColumn('string', 'Payment');
            data.addColumn('string', 'Address');
            data.addColumn('string', 'CreateDate');
            data.addColumn('string', 'Action');

            if (result.Result.length > 0) {
                for (var i = 0; i < result.Result.length; i++) {
                    var item = result.Result[i];
                    var button = "";
                    if (item.Status == 1) {
                        button = "<div align='center' style='background-color:#F7F57E;cursor:pointer;'><a class='btn-link btn-set-status-" + item.Id + "' onclick='SetApprove(" + item.Id + ")'>Pending</a></div>";
                    } else if (item.Status == 2) {
                        button = "<div align='center' style='background-color:#84F77E'>Processing</div>"
                    } else if (item.Status == 3) {
                        button = "<div align='center' style='background-color:#1100FF;color:#ffffff;'>Completed</div>"
                    } else if (item.Status == 4) {
                        button = "<div align='center' style='background-color:#FF0013'>Fail</div>"
                    }

                    var tmpRow = [
                        item.Id,
                        item.Username,
                        item.Amount,
                        item.WalletETH,
                        item.DisplayDate,
                        button
                    ];
                    data.addRow(tmpRow);
                }
                self.DrawTable(data);
                $(".table-list table").addClass("table");
            }
            else {
                $("#" + self.ContainerId + " .table-list").html(CommonPhrase.NoData);
                $(".table-list table").addClass("table");
            }
        }
        else {
            CommonHelper.ShowMsg("Error: " + result.Message, MsgIconType.Error);
        }
    }
    lib_load_list.Init("/manage/ApproveEthManage", "25");
    CommonHelper.SetHeadingTitle("Auto tranfer ETH");

    function SetApprove(id) {
        if (confirm("Are you sure ?")) {
            CommonHelper.AjaxLoading();
            var data = {
                'id': id
            };
            $.ajax({
                url: '/manage/withdrawtranfer',
                type: 'POST',
                data: JSON.stringify(data),
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                success: function (result) {
                    CommonHelper.StopAjaxLoading();
                    if (result > 0) {
                        $(".btn-set-status-" + id).removeAttr('onclick');
                        $(".btn-set-status-" + id).css('opacity', '0.3');
                        alert("update success");
                    }
                    else {
                        alert("update faild");
                    }
                },
                error: function () {
                    CommonHelper.StopAjaxLoading();
                    alert("update faild");
                }
            });
        }
    }
</script>


