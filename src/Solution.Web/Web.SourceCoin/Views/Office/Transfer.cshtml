<input type="hidden" value="@_helper.FormatNumber(Model.MoneyUSD)" id="get_balance_case" />

<link href="/Content/jquery-ui.css" rel="stylesheet" />

@Html.Partial("_DialogAuthen")

<script>
    var _fromtowalletforbit = true; 
    $("#get_balance_case").empty().val(_fromtowalletforbit);
    function changevalues() {
       // get text balance_limit when change value 
        if (_fromtowalletforbit) {
            _fromtowalletforbit = false;
            document.getElementById("from-address").value = "ForbitOption";
            document.getElementById("to-address").value = "CopyTrade";
            $("#get_balance_case").empty().val(_fromtowalletforbit);

        } else {
            _fromtowalletforbit = true;
            document.getElementById("from-address").value = "CopyTrade";
            document.getElementById("to-address").value = "ForbitOption";
            $("#get_balance_case").empty().val(_fromtowalletforbit);

        }
    }

    window.onload = buildData.CopytradeAccountBalance();
    window.onload = changevalues();

    $(document).ready(function () {
        buildData._callCheckValidAmountTranfer();
    });

    $('#transfer-id').on('click', function () {
        $(this).blur()
    })



 

</script>


