<style type="text/css">

    .list-unstyled .media {
        cursor: pointer;
    }

    .afiliateLink {
        display: inline-flex !important;
        width: 70%;
        float: left;
    }

    .copy {
        padding: 2px 4px !important;
        font-weight: inherit !important;
        font-size: 16px !important;
        float: right !important;
        width: 20% !important;
        background-color: #F58630;
        margin: 5px;
        text-align: center;
    }

    #main-wrapper {
        opacity: 0;
        transition: all 0.25s ease-in;
        overflow: hidden;
        position: fixed;
        z-index: 1;
        /* margin-top: 55px; */
        width: 100%;
        padding-top: 55px;
        height: calc(100% - 5px);
        overflow: hidden;
        top: 0px;
    }

    .content-body {
        height: calc(100vh - 75px);
    }

    .container-fluid {
        height: 100%;
    }

    .card.main-chart {
        margin-bottom: 0px;
    }

    .flags-line {
        z-index: 999 !important;
        display: inline-flex;
    }

        .flags-line span {
            width: auto;
            padding: 2px 5px;
            color: #fff;
            font-size: 13px
        }

            .flags-line span.down {
                background-color: chocolate;
            }

            .flags-line span.up {
                background-color: darkseagreen;
            }

        .flags-line img {
            margin-left: 2px;
        }

    .highcharts-bindings-wrapper * {
        box-sizing: content-box !important;
    }

    .tab-content {
        border: none;
    }
    .carousel-indicators {
        top: -20px !important;
        margin-bottom: 10px
    }

    .modal-header {
        background-color: #2b4354 !important
        /*border-top-left-radius: 0;
        border-top-left-radius: 0;*/
    }
    .modal-body {
        background: #263643;
        padding-top:0.5px;
    }
    .modal.show .modal-dialog {
        transform: none;
        border-top-left-radius: 0.8rem;
        border-top-right-radius: 0.8rem;
    }
    .carousel-indicators {
        top: -30px !important;
        margin-bottom: 10px;
    }
    .text-white-notice {
        color: #dadada !important;
    }
</style>
