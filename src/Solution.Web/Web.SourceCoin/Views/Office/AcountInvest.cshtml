@using Lib.Domain.Trees
@using Web.SourceCoin.Helpers
@{
    ViewBag.Title = "Account Invest";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var _helper = new Helper();
}
<link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
<script type="text/javascript">
    $(function () {
        $("#to-date").datepicker({ dateFormat: 'yy-mm-dd' });
        $("#from-date").datepicker({ dateFormat: 'yy-mm-dd' }).bind("change", function () {
            var minValue = $(this).val();
            minValue = $.datepicker.parseDate("yy-mm-dd", minValue);
            minValue.setDate(minValue.getDate());
            $("#to-date").datepicker("option", "minDate", minValue);
        })
    });
</script>
<style type="text/css">
    .transaction_select ul li {
        width: 24.33%;
    }
</style>
<div class="admin_body_bottom">
    <div class="row">
        <div class="col-lg-7 col-md-7">
            <div class="transaction_select mb-30">
                <ul>
                    <li class="form_block">
                        <select autocomplete="off" id="select-invest">
                            <option value="-1">-- Select Invest By --</option>
                            <option value="3">USD</option>
                            <option value="1">BTC</option>
                        </select>
                    </li>
                    <li class="form_block">
                        <select autocomplete="off" id="select-level">
                            <option value="-1">-- Select Generation --</option>
                            <option value="1">1st Generation</option>
                            <option value="2">2nd Generation</option>
                            <option value="3">3th Generation</option>
                            <option value="4">4th Generation</option>
                            <option value="5">5th Generation</option>
                            <option value="6">6th Generation</option>
                            <option value="7">7th Generation</option>
                            <option value="8">8th Generation</option>
                            <option value="9">9th Generation</option>
                            <option value="10">10th Generation</option>
                            <option value="11">11th Generation</option>
                            <option value="12">12th Generation</option>
                            <option value="13">13th Generation</option>
                            <option value="14">14th Generation</option>
                            <option value="15">15th Generation</option>
                        </select>
                    </li>
                    <li>
                        <input type="text" id="from-date" placeholder="From date">
                    </li>
                    <li>
                        <input type="text" id="to-date" placeholder="To date">
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-lg-2 col-md-2">
            <a href="javascript:void(0);" class="btn btn-success" id="btn-search-tree" style="width:100%">Search</a>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div style="width:100%;text-align:right;color:red;font-weight:bold;padding:15px;">Total Package: $<span id="total-tree"></span></div>
            <table id="dtListReferrals" class="table table-striped table-bordered dataTable no-footer">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>Username</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Package USD</th>
                        <th>Invest At</th>
                    </tr>
                </thead>
                <tbody id="html-data"></tbody>
            </table>
        </div>
    </div>
</div>
<script type="text/javascript">
    function showData() {
        var data = {
            "level": $("#select-level").val(),
            "from_date": $("#from-date").val(),
            "to_date": $("#to-date").val(),
            "method": $("#select-invest").val()
        };
        $.ajax({
            url: '/office/manageaccountinvest',
            type: 'POST',
            dataType: 'json',
            data: JSON.stringify(data),
            contentType: 'application/json; charset=utf-8',
            beforeSend: function () {
                CommonHelper.AjaxLoading();
            },
            success: function (result) {
                CommonHelper.StopAjaxLoading();
                if (result != null && result != "") {
                    $("#html-data").html(result.html);
                    $("#total-tree").text(result.total);
                } else {
                    $("#html-data").html("");
                    $("#total-tree").text(0);
                }
            },
            error: function () {
                CommonHelper.StopAjaxLoading();
            }
        });
    }

    showData();
    $(document).ready(function () {
        $('#btn-search-tree').click(function () {
            showData();
        });
    });
</script>
