    <div id="main-wrapper">
        <div class="header">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-xl-12">
                        <nav class="notranslate navbar navbar-expand-lg navbar-light px-0 justify-content-between">
                            <div class="profile_log dropdown menuleft">
                                <div data-toggle="dropdown" id="nav-mobile" class="m-display">
                                    <a href="javascript:void(0);" onclick="buildData._showLeftMenu();return false;">
