                                @*<span>Eq Option</span>*@
                            </a>
                            <div class="dashboard_log">
                                <div class="d-flex align-items-center">
                                    <div class="account_money d-desktop">
                                        <ul>
                                            <li class="crypto">
                                                <span>Total Trade</span>
                                            </li>
                                            <li class="usd">
                                                <span id="total-trade54"></span>
                                            </li>
                                            <li class="crypto" style="margin-left: 10px">
                                                <span>Balance</span>
                                            </li>
                                            <li class="usd">
                                                <span id="total-balance"></span>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="profile_log dropdown">
