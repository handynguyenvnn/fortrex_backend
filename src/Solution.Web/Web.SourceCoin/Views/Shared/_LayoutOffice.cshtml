                                Affiliates
                            </span>
                        </a>
                    </li>


                    <li>
                        <a href="/account/settings">
                            <span>
                                <img class="la" src="~/Images/Icon/navbar/Icon-Setting.png" />
                                Settings
                            </span>
                        </a>
                    </li>
                    <li>
                        <a href="/account/kyc">
                            <span>
                                <img class="la" src="~/Images/Icon/navbar/Icon-Setting.png" />
                                &nbsp; kyc &nbsp;
                            </span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="content-body">
            <div class="container-fluid">
                @RenderBody()
            </div>

        </div>



