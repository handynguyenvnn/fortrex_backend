@{
    Layout = null;
}
<style type="text/css">
    .icons.s {
        width: 30px;
        color: #fff !important;
        filter: invert(1);
    }

    .nav-link i.icons {
        font-size: 22px;
    }

    .navbar-sidenav .nav-link-text {
        transition: all 0.3s ease 0s;
        letter-spacing: 2px;
        line-height: 2;
    }

    .nav-link i.icons {
        font-size: 25px;
    }
</style>
<!-- Navbar -->
<link rel="stylesheet" href="/assets/css/fontawesome-all.min.css?v=5.9">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top" id="mainNav">
    <a class="navbar-brand" href="/office">
        <img class="logo" src="/images/logo-home-d.png" style="    height: 44px;" />
        <img class="logo_icon " src="/images/Logo-m.png" style="height: 44px;" />
    </a>
    <ul id="ul-time2" class="navbar-nav" style=" display: none; margin-right: 10%">
        <li class="nav-item" style="color: #E8A946;margin-right: 20px;" id="live_clock2">
        </li>
        <li class="nav-item" style="color: #E8A946;" id="today_date2">
        </li>
    </ul>
    <div class="mobile_menu">
        <button class="navbar-toggler navbar-toggler-right" type="button" data-toggle="collapse" data-target="#navbarResponsive" aria-controls="navbarResponsive" aria-expanded="false" aria-label="Toggle navigation">
            <span class="icon-menu icons"></span>
        </button>
        <a href="#" class="navbar-toggler" data-toggle="collapse" data-target="#navbarheader" aria-controls="navbarheader" aria-expanded="false" aria-label="Toggle navigation"><i class="icon-options-vertical"></i></a>
    </div>
    <div class="collapse navbar-collapse" id="navbarheader">
        <ul class="navbar-nav">
            <li class="nav-item d-none d-lg-block">
                <a class="nav-link text-center menubar" id="sidenavToggler">
                    <span class="line"></span>
                    <span class="line"></span>
                    <span class="line"></span>
                </a>
            </li>
            <li class="nav-item">
                <a href="javascript:void(0)" class="search_icon"><i class="fa fa-search"></i></a>
                <form class="form-inline search_input">
                    <div class="input-group">
                        <input class="form-control" type="text" placeholder="Search for...">
                        <span class="input-group-append">
                            <button class="btn btn-primary" type="button">
                                <i class="fa fa-search"></i>
                            </button>
                        </span>
                    </div>
                </form>
            </li>
            <li class="nav-item mar-icon" style="color: #E8A946;">
                <img class="d-icon" src="/Images/Icon/btc-logo.png" />
                <div>
                    <span>Bitcoin</span>
                    <b id="pricebtc"></b>
                </div>
            </li>
            <li class="nav-item mar-icon" style="color: #E8A946;">
                <img class="d-icon" src="/Images/Icon/eth-logo.png" />
                <div>
                    <span>Ethereum</span>
                    <b id="priceeth"></b>
                </div>
            </li>
            <li class="nav-item mar-icon" style="color: #E8A946;">
                <img class="d-icon" src="/Images/Icon/xrp-logo.png" style="padding: 2px 0px;" />
                <div>
                    <span>XRP</span>
                    <b id="pricexrp"></b>
                </div>
            </li>
            <li class="nav-item mar-icon" style="color: #E8A946;">
                <img class="d-icon" src="/Images/Icon/xlm-logo.png" />
                <div>
                    <span>Stellar</span>
                    <b id="pricexlm"></b>
                </div>
            </li>
            <li class="nav-item mar-icon" style="color: #E8A946;">
                <img class="d-icon" src="/Images/Icon/ltc-logo.png" />
                <div>
                    <span>LiteCoin</span>
                    <b id="priceltc"></b>
                </div>
            </li>
        </ul>
        <ul class="navbar-nav ml-auto align-items-center">
            <li class="nav-item dropdown menu_user">
                <a class="nav-link dropdown-toggle" id="userDropdown" href="#" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <span class="user_img"><img src="/assets/dash/images/user_img.png" alt="user4" /></span> @User.Identity.Name
                </a>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="userDropdown">
                    <ul class="menu-nav list_none">
                        <li><a href="/user-profile"><i class="icon-wallet icons"></i><span>Settings</span></a></li>
                        <li><div class="dropdown-divider"></div></li>
                        <li><a href="/home/logout" data-toggle="modal" data-target="#exampleModal"><i class="icon-logout icons"></i>Logout</a></li>
                    </ul>
                </div>
            </li>
        </ul>
