                    <img class="icon-bag icons s" src="~/Images/Icon/invest.svg" />
                    <span class="nav-link-text">BOTs Packages</span>
                </a>

            </li>
            <li class="nav-item">
                <a class="nav-link" href="/account/operation">
                    @*<i class="icon-shuffle icons"></i>*@
                    <img class="icon-bag icons s" src="~/Images/Icon/chart.svg" style="height: 26px;" />
                    <span class="nav-link-text">Finance Trading</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link nav-link-collapse collapsed" data-toggle="collapse" href="#collapseWallet" data-parent="#exampleAccordion">
                    @*<i class="icon-wallet icons"></i>*@
                    <img class="icon-bag icons s" src="~/Images/Icon/wallet.svg" style="padding: 2px;" />
                    <span class="nav-link-text">My Wallet</span>
                </a>
                <ul class="sidenav-second-level collapse" id="collapseWallet">
                    <li>
                        <a href="/deposit">Deposit</a>
                    </li>
                    @*<li>
                            <a href="/mywallet">USD Wallet</a>
                        </li>*@

                    @*<li>
                            <a href="/transfer">Transfer</a>
                        </li>*@
                    <li>
                        <a href="/withdraw">Withdraw</a>
                    </li>

                </ul>

            </li>

            @*<li class="nav-item">
                    <a class="nav-link" href="/office/icocountdown">
                        <i class="icon-clock icons"></i>
                        <span class="nav-link-text">ICO Sell Countdown</span>
                    </a>
                </li>*@
            <li class="nav-item">
                <a class="nav-link" href="/account/treeview">
                    <img class="icon-bag icons s" src="~/Images/Icon/setting-menu-networks.svg" />
                    <span class="nav-link-text">Networks</span>
                </a>
            </li>
            <li class="nav-item">

                <a class="nav-link" href="/office/manageaccount">
                    @*<i class="icon-user icons"></i>*@
                    <img class="icon-bag icons s" src="~/Images/Icon/level.svg" />
                    <span class="nav-link-text">Referrals</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link nav-link-collapse collapsed" data-toggle="collapse" href="#collapseAccount" data-parent="#exampleAccordion">
                    @*<i class="icon-settings icons"></i>*@
                    <img class="icon-bag icons s" src="~/Images/Icon/settings.svg" style="padding: 2px;" />
                    <span class="nav-link-text">Settings</span>
                </a>
                <ul class="sidenav-second-level collapse" id="collapseAccount">
                    <li>
                        <a href="/user-profile">Profile</a>
                    </li>
                    <li>
                        <a href="/account/kyc">KYC</a>
                    </li>
                    <li>
                        <a href="/account/2fa">Authentication (2FA)</a>
                    </li>
                </ul>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    @*<i class="icon-shuffle icons"></i>*@
                    <img class="icon-bag icons s" src="~/Images/Icon/exchange.svg" />
                    <span class="nav-link-text">Exchange</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/Upload/FORBIT TRADING MARKETING PLAN.pdf">
                    <img class="icon-bag icons s" src="/Images/Icon/download.svg" />
                    <span class="nav-link-text">Download</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/office/ticket">
                    @*<i class="icon-question icons"></i>*@
                    <img class="icon-bag icons s" src="~/Images/Icon/setting-menu-support.svg" />
                    <span class="nav-link-text">Support</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/office/notify">
                    @*<i class="icon-question icons"></i>*@
                    <img class="icon-bag icons s" src="~/Images/Icon/bell.svg" />
                    <span class="nav-link-text">Notification</span>
