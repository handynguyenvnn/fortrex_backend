                            </span>
                        </a>
                    </li>
                    <li>
                        <span class="cm-badge badge-new-red">new</span>
                        <a href="/transfer">
                            <span>
                                <img class="la" src="~/Images/Icon/navbar/Icon-Transfer.png"/>
                                Transfer
                            </span>
                        </a>
                    </li>
                    <li>
                        <a class="click-btn" href="/deposit">
