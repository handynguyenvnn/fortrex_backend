
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>@ViewBag.Title</title>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="@ViewBag.description" />
    <meta property="og:description" content="@ViewBag.description" />
    <link rel="stylesheet" type="text/css" href="/assets/css/bootstrap.min.css?v=5.9" />
    <link rel="stylesheet" type="text/css" href="/assets/css/hover-min.css" />
    <link rel="stylesheet" type="text/css" href="/assets/css/animate.css" />
    <link rel="stylesheet" type="text/css" href="/assets/css/themify-icons.css" />
    <link rel="stylesheet" type="text/css" href="/assets/css/side_menu.css" />
    <link rel="stylesheet" type="text/css" href="/assets/css/font-awesome.min.css" />
    <link rel="stylesheet" type="text/css" href="/assets/css/typography.css?v=1.1" />
    <link rel="stylesheet" type="text/css" href="/assets/css/style2.css?v=1.2.114" />
    <link href="/Content/loading-css.css" rel="stylesheet" />
    <link href="/assets/tem/new_forms.css" rel="stylesheet" />
    <link href="/assets/tem/styles.css?v=5.9" rel="stylesheet" />
    <link href="/assets/tem/actions.css?v=5.9" rel="stylesheet" />
    <link href="/assets/tem/difiz.css" rel="stylesheet" />
    <link href="/assets/tem/account.css?v=5.9" rel="stylesheet" />
    <link href="/assets/tem/general.css" rel="stylesheet" />
    <link href="/assets/tem/merchant_logo.css?1551688432" rel="stylesheet" type="text/css">
    <link href="/assets/tem/exchange_logo_new.css?1551429381" rel="stylesheet" type="text/css">
    <link href="~/Content/jqueryConfirm/jquery-confirm.min.css?v=5.9" rel="stylesheet" />
    <link href="~/assets/Responsive/Responsive.css?v=5.9" rel="stylesheet" />
    <script type="text/javascript" src="@Url.Content("~/assets/js/jquery-2.1.4.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.blockUI.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Content/jqueryConfirm/jquery-confirm.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/notify/bootstrap-notify.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/notify/instascan.min.js")"></script>
    @Scripts.Render("~/jquery_plugins")
</head>

<body class="dashbody">
    <div id="ui" class="ui">
        <!--header start-->
        <header id="header" class="ui-header">
            <div class="navbar-header">
                <a href="#" class="navbar-brand">
                    <span class="logo"><img class="ofs ad-logo" src="~/assets/images/logo-ofs.svg?v=5.9" alt="logo"></span>
                    <span class="logo-compact">
                        <img class="ad-logo" src="~/assets/images/g-logo.svg" />
                    </span>
                </a>
            </div>
            <div class="navbar-collapse nav-responsive-disabled">
                <ul class="nav navbar-nav">
                    <li><a class="toggle-btn" data-toggle="ui-nav" href="javascript:void(0)"><i class="fa fa-ellipsis-v"></i></a></li>
                </ul>
                <div class="admin_title">
                    <h4> @ViewBag.Title</h4>
                </div>
                <div class="admin_top_right">
                    <div class="currency_data">
                        <ul id="currency-data"></ul>
                    </div>
                    <span class="theme-color1" style="font-weight: bold;text-transform: uppercase;font-size: 16px;vertical-align: middle;">@User.Identity.Name</span>
                    <div class="admin_user">
                        <h4>
                            <span class="dropdown">
                                <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                    <i class="icon-user"></i>
                                    <i class="fa fa-caret-down"></i>
                                </a>
                                <ul class="dropdown-menu">
                                    <li><i class="icon-user"></i><a href="/user-profile">Edit Account</a></li>
                                    <li><i class="icon-security"></i><a href="/account/2fa">Security</a></li>
                                </ul>
                            </span>
                        </h4>

                    </div>
                    <div class="logout_link">
                        <ul>
                            <li><a href="#" data-toggle="modal" data-target="#logoutModal">Logout <i class="icon-logout"></i></a></li>
                        </ul>
                    </div>
                </div>

            </div>
        </header>
        <!--header end-->
        <!--sidebar start-->
        @Html.Partial("_MenuTopAdminPartial")
        <!--sidebar end-->
        <div id="content" class="ui-content ui-content-aside-overlay">
            <div class="ui-content-body">
                <div class="ui-container">
                    <div class="admin_body">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>


    </div>
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Ready to Leave?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">Select "Logout" below if you are ready to end your current session.</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                    <a class="btn btn-primary" href="/home/logout">Logout</a>
                </div>
            </div>
        </div>
    </div>
    @Scripts.Render("~/assets/side_menu")
    @Scripts.Render("~/assets/loadpage")
</body>
</html>