<style type="text/css">
    .registerButton {
        color: #233a65 !important;
        transition: .2s ease-in-out !important;
        padding: 3px 20px;
        font-size: 18px;
        height: 32px;
    }

        .registerButton:hover {
            transition: .2s ease-in-out !important;
        }

    .alert-success {
        border-top: solid 3px #449D44 !important;
        color: #fff !important;
        background-color: #5cb85c !important;
        border-color: #4cae4c !important;
        padding: 20px 30px;
        width: auto;
        font-weight: 700;
        font-size: 15px;
    }

    .alert-warning {
        border-top: solid 3px #449D44 !important;
        background-color: #FFBB33;
        color: #000;
        border-color: #635932;
        padding: 20px 30px;
        width: auto;
        font-weight: 700;
        font-size: 15px;
    }
</style>
