<link href="~/Content/WidgetsLiveStock/WBITickerblue.css?v=5.9" rel="stylesheet" />
@*<script src="~/Content/WidgetsLiveStock/jquery-1.3.1.min.js"></script>*@
<script src="~/Content/WidgetsLiveStock/WBIHorizontalTicker2.js?v=5.9"></script>
<div id="livestock">
   
</div>
<script>
    function settinglivestock() {
        var flag = window.localStorage.getItem('widgetslivestock');
        if ("off" == flag) {
            window.localStorage.setItem('widgetslivestock', "on");
            livestock();
        } else {
            window.localStorage.setItem('widgetslivestock', "off");
            livestock();
        }
    }
    function livestock() {
        var turnonlivestock = window.localStorage.getItem('widgetslivestock');
        if ("off" == turnonlivestock) {
            document.getElementById("livestock").innerHTML = "";
            $("#arrowlivestock").removeClass("fa-arrow-up");
            $("#arrowlivestock").addClass("fa-arrow-down");
        } else {
            var gainerTick = new WBIHorizontalTicker('gainers');
            gainerTick.start();
            //var loserTick = new WBIHorizontalTicker('losers');
            //loserTick.start();
            $("#arrowlivestock").removeClass("fa-arrow-down");
            $("#arrowlivestock").addClass("fa-arrow-up");
            
        }
    }
    window.onload = livestock();
</script>